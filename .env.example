# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_
# Same value as Supabase Edge Function secret PUSH_ADMIN_SECRET
PUSH_ADMIN_SECRET=

# Comma-separated admin emails allowed to use /admin/push
ADMIN_EMAILS=you@example.com

# Contact form (/kontakt) via Brevo SMTP. Server-only — never prefix with NEXT_PUBLIC_
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
